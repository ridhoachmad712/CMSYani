APP_NAME="KAP Muhammad Yani"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Produksi: set APP_ENV=production, APP_DEBUG=false, dan APP_URL sesuai domain (https)
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Server bawaan `php artisan serve` (di Windows abaikan; upload file bisa
# butuh nilai >1 di Linux/Mac untuk request bersamaan).
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================================
# DATABASE
# Lokal (dev): SQLite. Produksi (Hostinger): ganti ke MySQL di bawah.
# ==========================================================================
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nama_database_hostinger
# DB_USERNAME=user_database_hostinger
# DB_PASSWORD=password_database_hostinger

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================================
# MAIL (notifikasi form kontak)
# Lokal: 'log' (email ditulis ke storage/logs). Produksi: SMTP.
# Contoh SMTP (Gmail App Password / SMTP Hostinger) di komentar bawah.
# ==========================================================================
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=muh.yani2013@gmail.com
# MAIL_PASSWORD="app-password-google-16-karakter"
# MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="muh.yani2013@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
